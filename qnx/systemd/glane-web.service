# glane-web.service — Vitrine HTTP de GLANE (écran VGA, console, touches).
#
# Adapté de qnx-emu/systemd/replique-ems-web.service.
# Lit l'écran VGA via le moniteur QEMU et la console via le journal série :
# ces chemins doivent être IDENTIQUES à ceux de l'unité QEMU jumelle
# (glane-qemu.service).
#
# NOTE — %h n'est PAS développé dans Environment= (systemd) : chemins absolus.
[Unit]
Description=Vitrine HTTP — Glane (écran, console, touches)
After=glane-qemu.service

[Service]
Type=simple
Environment=QNX_EMS_SERIE=/home/baptiste/Bureau/glane/build-qnx/vitrine/serial.log
Environment=QNX_EMS_MON=/home/baptiste/Bureau/glane/build-qnx/vitrine/mon.sock
Environment=QNX_EMS_PPM=/home/baptiste/Bureau/glane/build-qnx/vitrine/web-vga.ppm
Environment=QNX_EMS_PORT=8101
Environment="QNX_EMS_TITRE=Glane sur QNX 8.0"
Environment="QNX_EMS_NOTE=invité QNX 8.0 (QEMU/TCG) — glaned publie ses mesures dans /dev/shmem"
ExecStart=/usr/bin/python3 %h/Bureau/qnx-emu/web.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
